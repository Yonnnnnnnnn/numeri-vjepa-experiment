    SELECT
        time_bucket($resolution, recorded_timestamp) AS x,
        SUM(histogram_count) AS amount,
        (
            CASE WHEN service_namespace = '' OR service_namespace IS NULL THEN '' ELSE service_namespace || ' ' END ||
            CASE WHEN service_name in ('', 'unknown_service') OR service_name IS NULL THEN '' ELSE service_name || ' ' END ||
            COALESCE(attributes ->> 'http.request.method', attributes ->> 'http.method') || ' ' ||
            COALESCE(attributes ->> 'http.route', attributes ->> 'http.target')
        ) AS endpoint,
        (COALESCE(attributes->>'http.response.status_code', attributes->>'http.status_code'))::int as status_code
    FROM metrics
    WHERE metric_name in ('http.server.duration', 'http.server.request.duration') and aggregation_temporality = 'delta'
    GROUP BY x, endpoint, status_code
    HAVING endpoint is not null
),
errors as (
    SELECT x, sum(amount) as error_amount, status_code, endpoint
    from dataset
    where status_code >= 500
    GROUP BY x, status_code, endpoint
),
totals as (
    SELECT x, sum(amount) as total_amount, endpoint
    from dataset
    GROUP BY x, endpoint
),
joined as (select errors.x,
                  errors.error_amount * 100.0 / totals.total_amount              as amount,
                  (errors.endpoint || ' → ' || errors.status_code) as endpoint
           from errors join totals on errors.x = totals.x and errors.endpoint = totals.endpoint
),
ranked AS (
    SELECT
        x,
        amount,
        endpoint,
        ROW_NUMBER() OVER (PARTITION BY x ORDER BY amount DESC) AS row_num
    FROM joined
)
SELECT
    x,
    amount,
    endpoint
FROM ranked
WHERE row_num <= 5
ORDER BY x;
`,groupBy:"endpoint",metrics:["amount"]}}}}]}},"Requests5xxByEndpointTS-2":{kind:"Panel",spec:{display:{name:"4xx error rate by service, endpoint, and status code (Top 5 per interval)"},plugin:{kind:"TimeSeriesChart",spec:{yAxis:{show:!0,label:"",format:{unit:"percent"}},legend:{position:"bottom"},visual:{display:"line",areaOpacity:.25}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`WITH dataset AS (
    SELECT
        time_bucket($resolution, recorded_timestamp) AS x,
        SUM(histogram_count) AS amount,
        (
            CASE WHEN service_namespace = '' OR service_namespace IS NULL THEN '' ELSE service_namespace || ' ' END ||
            CASE WHEN service_name in ('', 'unknown_service') OR service_name IS NULL THEN '' ELSE service_name || ' ' END ||
            COALESCE(attributes ->> 'http.request.method', attributes ->> 'http.method') || ' ' ||
            COALESCE(attributes ->> 'http.route', attributes ->> 'http.target')
        ) AS endpoint,
        (COALESCE(attributes->>'http.response.status_code', attributes->>'http.status_code'))::int as status_code
    FROM metrics
    WHERE metric_name in ('http.server.duration', 'http.server.request.duration') and aggregation_temporality = 'delta'
    GROUP BY x, endpoint, status_code
    HAVING endpoint is not null
),
errors as (
    SELECT x, sum(amount) as error_amount, status_code, endpoint
    from dataset
    where status_code >= 400 and status_code < 500
    GROUP BY x, status_code, endpoint
),
totals as (
    SELECT x, sum(amount) as total_amount, endpoint
    from dataset
    GROUP BY x, endpoint
),
joined as (select errors.x,
                  errors.error_amount * 100.0 / totals.total_amount              as amount,
                  (errors.endpoint || ' → ' || errors.status_code) as endpoint
           from errors join totals on errors.x = totals.x and errors.endpoint = totals.endpoint
),
ranked AS (
    SELECT
        x,
        amount,
        endpoint,
        ROW_NUMBER() OVER (PARTITION BY x ORDER BY amount DESC) AS row_num
    FROM joined
)
SELECT
    x,
    amount,
    endpoint
FROM ranked
WHERE row_num <= 5
ORDER BY x;
`,groupBy:"endpoint",metrics:["amount"]}}}}]}},"TotalDurationByEndpointTS-2":{kind:"Panel",spec:{display:{name:"P95 in seconds by service and endpoint (Top 5 per interval)"},plugin:{kind:"TimeSeriesChart",spec:{yAxis:{show:!0,label:"Seconds",format:{unit:"seconds",decimalPlaces:2}},legend:{position:"bottom"},visual:{display:"line",areaOpacity:.25}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`with indices as (
    select *, unnest(generate_series(1, array_length(exp_histogram_positive_bucket_counts, 1)::integer)) AS bucket_index
    from metrics
),
counts as (
    select *, exp_histogram_positive_bucket_counts[bucket_index] as bucket_count
    from indices
),
bounds as (
    select
        counts.*,
        greatest(
            histogram_min,
            power(2.0, (exp_histogram_positive_bucket_counts_offset+bucket_index-1)/power(2.0, exp_histogram_scale))
        ) as lower_bound,
        least(
            histogram_max,
            power(2.0, (exp_histogram_positive_bucket_counts_offset+bucket_index  )/power(2.0, exp_histogram_scale))
        ) as upper_bound
    from counts
    where bucket_count > 0
),
bounds_with_index as (
    select unnest(generate_series(0, bucket_count - 1)) as i, *
    from bounds
),
bucket_item_approx as (
    select
    case
        when bucket_count = 1 then (lower_bound + upper_bound) / 2
        else lower_bound + i * (upper_bound - lower_bound) / (bucket_count - 1)
    end as approx_item, *
    from bounds_with_index
),
dataset AS (
    SELECT
        time_bucket($resolution, recorded_timestamp) AS x,
        approx_percentile_cont(0.95) WITHIN GROUP (ORDER BY approx_item / 1000) as amount,
        (
            CASE WHEN service_namespace = '' OR service_namespace IS NULL THEN '' ELSE service_namespace || ' ' END ||
            CASE WHEN service_name in ('', 'unknown_service') OR service_name IS NULL THEN '' ELSE service_name || ' ' END ||
            COALESCE(attributes ->> 'http.request.method', attributes ->> 'http.method') || ' ' ||
            COALESCE(attributes ->> 'http.route', attributes ->> 'http.target')
        ) AS endpoint
    FROM bucket_item_approx
    WHERE metric_name in ('http.server.duration', 'http.server.request.duration') and aggregation_temporality = 'delta'
    GROUP BY x, endpoint
    HAVING endpoint is not null
),
ranked AS (
    SELECT
        x,
        amount,
        endpoint,
        ROW_NUMBER() OVER (PARTITION BY x ORDER BY amount DESC) AS row_num
    FROM dataset
)
SELECT
    x,
    amount,
    endpoint
FROM ranked
WHERE row_num <= 5
ORDER BY x;`,groupBy:"endpoint",metrics:["amount"]}}}}]}},"TotalDurationByEndpointTS-3":{kind:"Panel",spec:{display:{name:"Overall duration percentiles"},plugin:{kind:"TimeSeriesChart",spec:{yAxis:{show:!0,label:"Seconds",format:{unit:"seconds",decimalPlaces:2}},legend:{mode:"list",position:"bottom"},visual:{display:"line",areaOpacity:.25}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`with indices as (
    select *, unnest(generate_series(1, array_length(exp_histogram_positive_bucket_counts, 1)::integer)) AS bucket_index
    from metrics
),
counts as (
    select *, exp_histogram_positive_bucket_counts[bucket_index] as bucket_count
    from indices
),
bounds as (
    select
        counts.*,
        greatest(
            histogram_min,
            power(2.0, (exp_histogram_positive_bucket_counts_offset+bucket_index-1)/power(2.0, exp_histogram_scale))
        ) as lower_bound,
        least(
            histogram_max,
            power(2.0, (exp_histogram_positive_bucket_counts_offset+bucket_index  )/power(2.0, exp_histogram_scale))
        ) as upper_bound
    from counts
    where bucket_count > 0
),
bounds_with_index as (
    select unnest(generate_series(0, bucket_count - 1)) as i, *
    from bounds
),
bucket_item_approx as (
    select
    case
        when bucket_count = 1 then (lower_bound + upper_bound) / 2
        else lower_bound + i * (upper_bound - lower_bound) / (bucket_count - 1)
    end / 1000 as approx_item, *
    from bounds_with_index
)
SELECT
    time_bucket($resolution, recorded_timestamp) AS x,
    approx_percentile_cont(0.80) WITHIN GROUP (ORDER BY approx_item) as "P80",
    approx_percentile_cont(0.90) WITHIN GROUP (ORDER BY approx_item) as "P90",
    approx_percentile_cont(0.95) WITHIN GROUP (ORDER BY approx_item) as "P95"

FROM bucket_item_approx
WHERE metric_name in ('http.server.duration', 'http.server.request.duration') and aggregation_temporality = 'delta'
GROUP BY x`}}}}]}}},layouts:[{kind:"Grid",spec:{display:{title:"Web Server Metrics",collapse:{open:!0}},items:[{x:0,y:0,width:12,height:8,content:{$ref:"#/spec/panels/TotalDurationByRouteBar"}},{x:12,y:0,width:12,height:8,content:{$ref:"#/spec/panels/AvgDurationByRouteBar"}},{x:0,y:32,width:24,height:8,content:{$ref:"#/spec/panels/TotalDurationByEndpointTS"}},{x:0,y:16,width:24,height:8,content:{$ref:"#/spec/panels/TotalDurationByEndpointTS-2"}},{x:0,y:8,width:24,height:8,content:{$ref:"#/spec/panels/TotalDurationByEndpointTS-3"}},{x:0,y:24,width:24,height:8,content:{$ref:"#/spec/panels/AvgDurationByEndpointTS"}},{x:0,y:40,width:24,height:8,content:{$ref:"#/spec/panels/Requests2xxByEndpointTS"}},{x:0,y:56,width:24,height:8,content:{$ref:"#/spec/panels/Requests5xxByEndpointTS"}},{x:0,y:48,width:24,height:8,content:{$ref:"#/spec/panels/Requests5xxByEndpointTS-1"}},{x:0,y:64,width:24,height:8,content:{$ref:"#/spec/panels/Requests5xxByEndpointTS-2"}},{x:0,y:72,width:24,height:8,content:{$ref:"#/spec/panels/Requests4xxByEndpointTS"}}]}}],variables:[],duration:"1h"}},{id:"standard-token-usage-records-dashboard",slug:"token-usage-records",spec:{display:{name:"LLM Tokens and Costs (from records)",description:"Input and output LLM tokens and costs over time by model. (more compatible with different instrumentations, and more flexible if used as a template)"},panels:{Bytypetotals:{kind:"Panel",spec:{display:{name:"By type totals"},plugin:{kind:"Values",spec:{}},queries:[{kind:"NonTimeSeriesQuery",spec:{plugin:{kind:"LogfireNonTimeSeriesQuery",spec:{query:`select
    sum(attributes->'gen_ai.usage.input_tokens') as "Input",
    sum(attributes->'gen_ai.usage.output_tokens') as "Output"
from records
where attributes ? 'gen_ai.usage.input_tokens'
  and attributes ? 'gen_ai.request.model'
`}}}}]}},chart_1_t3xime:{kind:"Panel",spec:{display:{name:"By type"},plugin:{kind:"TimeSeriesChart",spec:{yAxis:{show:!0,label:"Tokens",format:{unit:"decimal",shortValues:!0}},legend:{position:"bottom"},visual:{display:"line"}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`select
    sum(attributes->'gen_ai.usage.input_tokens') as "Input",
    sum(attributes->'gen_ai.usage.output_tokens') as "Output",
    time_bucket($resolution, start_timestamp) AS x
from records
where attributes ? 'gen_ai.request.model'
group by x
`,metrics:["Input","Output"]}}}}]}},"chart_2+1747316590012":{kind:"Panel",spec:{display:{name:"By model and type"},plugin:{kind:"TimeSeriesChart",spec:{yAxis:{show:!0,label:"Tokens"},legend:{position:"bottom"},visual:{display:"line"}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`select
    sum(attributes->'gen_ai.usage.input_tokens') as "Input",
    sum(attributes->'gen_ai.usage.output_tokens') as "Output",
    attributes->>'gen_ai.request.model' as model,
    time_bucket($resolution, start_timestamp) AS x
from records
where attributes ? 'gen_ai.request.model'
group by x, model`,groupBy:"model",metrics:["Input","Output"]}}}}]}},"chart_2 + 1747316590012":{kind:"Panel",spec:{display:{name:"By model"},plugin:{kind:"TimeSeriesChart",spec:{yAxis:{show:!0,label:"Tokens"},legend:{position:"bottom"},visual:{display:"line"}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`select
    sum(attributes->'gen_ai.usage.input_tokens') + sum(attributes->'gen_ai.usage.output_tokens') as tokens,
    attributes->>'gen_ai.request.model' as model,
    time_bucket($resolution, start_timestamp) AS x
from records
where attributes ? 'gen_ai.request.model'
group by x, model`,groupBy:"model",metrics:["tokens"]}}}}]}},"chart_3 + 1747326794506":{kind:"Panel",spec:{display:{name:"By model totals"},plugin:{kind:"BarChart",spec:{mode:"value",sort:"desc",format:{unit:"decimal",shortValues:!0},showValues:!0,calculation:"last"}},queries:[{kind:"NonTimeSeriesQuery",spec:{plugin:{kind:"LogfireNonTimeSeriesQuery",spec:{query:`select * from (
  select
      sum(attributes->'gen_ai.usage.input_tokens') + sum(attributes->'gen_ai.usage.output_tokens') as tokens,
      attributes->>'gen_ai.request.model' as model
  from records
  where attributes ? 'gen_ai.request.model'
  group by model
) order by tokens desc`,groupBy:"",metrics:[]}}}}]}},"chart_2+1747316590012-1":{kind:"Panel",spec:{display:{name:"By model"},plugin:{kind:"TimeSeriesChart",spec:{yAxis:{show:!0,label:"Cost ($)"},legend:{position:"bottom"},visual:{display:"line"}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`select
    sum(attributes->'operation.cost') as cost,
    attributes->>'gen_ai.request.model' as model,
    time_bucket($resolution, start_timestamp) AS x
from records
where attributes ? 'gen_ai.request.model'
  and attributes ? 'operation.cost'
group by x, model`,groupBy:"model",metrics:["cost"]}}}}]}},"chart_3+1747326794506":{kind:"Panel",spec:{display:{name:"By model totals"},plugin:{kind:"BarChart",spec:{mode:"value",sort:"desc",format:{unit:"decimal",shortValues:!0},showValues:!0,calculation:"last"}},queries:[{kind:"NonTimeSeriesQuery",spec:{plugin:{kind:"LogfireNonTimeSeriesQuery",spec:{query:`select * from (
  select
      sum(attributes->'operation.cost') as cost,
      attributes->>'gen_ai.request.model' as model
  from records
  where attributes ? 'gen_ai.request.model'
  group by model
) order by cost desc`,groupBy:"",metrics:[]}}}}]}},"Bytypetotals-1":{kind:"Panel",spec:{display:{name:"Total Cost"},plugin:{kind:"Values",spec:{}},queries:[{kind:"NonTimeSeriesQuery",spec:{plugin:{kind:"LogfireNonTimeSeriesQuery",spec:{query:`with result as (
  select sum(attributes->'operation.cost') as x
  from records
  where attributes ? 'operation.cost'

    -- Ignore costs not from LLMs
    and attributes ? 'gen_ai.request.model'
)

-- Everything below here is just fussing over display
select '$' || coalesce(
  CASE
    -- For 3 digits or more, just round to the nearest integer.
    -- Also for 0 to avoid errors in the case below when taking LOG10.
    WHEN x >= 100 or x = 0 THEN ROUND(x)::decimal

    -- For small numbers, round to 3 significant figures.
    -- Use decimals to avoid displaying loads of digits due to floating point weirdness.
    ELSE
        ROUND(x / POWER(10.0, FLOOR(LOG10(x))), 2)::decimal
        * POWER(10.0, FLOOR(LOG10(x)))::decimal
  END
  -- Cast back to float to avoid displaying trailing zeroes after converting to string.
, 0)::float as "" from result
`}}}}]}}},layouts:[{kind:"Grid",spec:{display:{title:"Token usage",collapse:{open:!0}},items:[{x:0,y:8,width:24,height:8,content:{$ref:"#/spec/panels/chart_1_t3xime"}},{x:0,y:0,width:24,height:8,content:{$ref:"#/spec/panels/chart_2+1747316590012"}},{x:0,y:16,width:24,height:8,content:{$ref:"#/spec/panels/chart_2 + 1747316590012"}},{x:0,y:24,width:12,height:14,content:{$ref:"#/spec/panels/chart_3 + 1747326794506"}},{x:12,y:24,width:12,height:14,content:{$ref:"#/spec/panels/Bytypetotals"}}]}},{kind:"Grid",spec:{display:{title:"Costs (Pydantic AI only)",collapse:{open:!0}},items:[{x:0,y:8,width:12,height:14,content:{$ref:"#/spec/panels/chart_3+1747326794506"}},{x:12,y:8,width:12,height:14,content:{$ref:"#/spec/panels/Bytypetotals-1"}},{x:0,y:0,width:24,height:8,content:{$ref:"#/spec/panels/chart_2+1747316590012-1"}}]}}],variables:[],duration:"1h"}},{id:"standard-token-usage-metrics-dashboard",slug:"token-usage-metrics",spec:{display:{name:"LLM Tokens and Costs (from metrics)",description:"Input and output LLM tokens and costs over time by model. (loads faster, more accurate if records are sampled)"},panels:{Bytypetotals:{kind:"Panel",spec:{display:{name:"Total input tokens"},plugin:{kind:"Values",spec:{}},queries:[{kind:"NonTimeSeriesQuery",spec:{plugin:{kind:"LogfireNonTimeSeriesQuery",spec:{query:`select
    sum(histogram_sum) as "Input tokens"
from metrics
where metric_name = 'gen_ai.client.token.usage' and attributes->>'gen_ai.token.type' == 'input' and aggregation_temporality = 'delta'`}}}}]}},"Bytypetotals-1":{kind:"Panel",spec:{display:{name:"Total output tokens"},plugin:{kind:"Values",spec:{}},queries:[{kind:"NonTimeSeriesQuery",spec:{plugin:{kind:"LogfireNonTimeSeriesQuery",spec:{query:`select
    sum(histogram_sum) as "Output tokens"
