    time_bucket($resolution, recorded_timestamp) AS x
from metrics
where metric_name = 'operation.cost' and aggregation_temporality = 'delta'
group by type, x`,groupBy:"type",metrics:["cost"]}}}}]}},"chart_2+1747316590012":{kind:"Panel",spec:{display:{name:"By model and type"},plugin:{kind:"TimeSeriesChart",spec:{yAxis:{show:!0,label:"Tokens"},legend:{position:"bottom"},visual:{display:"line"}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`select
