    sum(histogram_sum) as "Output cost"
from metrics
where metric_name = 'operation.cost' and attributes->>'gen_ai.token.type' == 'output' and aggregation_temporality = 'delta'`}}}}]}},"chart_1_t3xime-cost":{kind:"Panel",spec:{display:{name:"Cost by type"},plugin:{kind:"TimeSeriesChart",spec:{yAxis:{show:!0,label:"Cost ($)",format:{unit:"decimal",shortValues:!0}},legend:{position:"bottom"},visual:{display:"line"}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`select
    sum(histogram_sum) cost,
