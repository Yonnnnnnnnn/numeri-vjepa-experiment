{async lazy(){return{Component:(await E(()=>import("./organization-page-loader-fu3Ev5O4.js"),__vite__mapDeps([54,1,2,3,4,5,6]))).OrganizationPageLoader}},children:[{id:"organization-overview",index:!0,async lazy(){return{Component:(await E(()=>import("./overview-page-CpUawxER.js"),__vite__mapDeps([55,1,2,3,4,5,6]))).OverviewPage}}},{id:"organization-internal",path:d.ORGANIZATION.INTERNAL.path,children:[{id:"organization-projects",path:d.ORGANIZATION.INTERNAL.PROJECTS.path,handle:{crumb:()=>"Projects"},children:[{index:!0,async lazy(){return{Component:(await E(()=>import("./projects-page-BThIkoRr.js"),__vite__mapDeps([56,1,2,3,4,5,6,57,58]))).ProjectsPage}}},{id:"project-create",path:d.ORGANIZATION.INTERNAL.PROJECTS.NEW.path,lazy:async()=>({Component:(await E(()=>import("./project-new-z7F-fG1v.js"),__vite__mapDeps([59,1,2,3,4,5,6]))).ProjectNew})}]},fv]}]}]},zo="logfire-meta-dashboard",Xe="logfire-ff-maintenance-worker",et="logfire-ff-compaction-worker",Wn="logfire-ff-ingest",bv="logfire-ff-cache-filter",Nv=[{id:"standard-exceptions-dashboard",slug:"exceptions",spec:{duration:"1h",display:{name:"Exceptions",description:"Overview of most common exceptions in spans and logs."},panels:{Exceptions:{kind:"Panel",spec:{display:{name:"Exceptions"},plugin:{kind:"Table",spec:{}},queries:[{kind:"NonTimeSeriesQuery",spec:{plugin:{kind:"LogfireNonTimeSeriesQuery",spec:{query:`-- This query aggregates error logs to show the most common patterns,
-- where a pattern is defined by (service_name, otel_scope_name, span_name, exception_type).
-- For each pattern, it shows aggregated lists of the top messages and exception messages.

-- Step 1: Calculate counts for each unique combination of all error fields.
WITH UniqueErrorCounts AS (
    SELECT
        service_name, otel_scope_name, span_name, message, exception_type, exception_message,
        COUNT(1) AS specific_count
    FROM records
    WHERE is_exception
        AND ($errors_only = 'No' or level >= 'error')
        AND $service_name in ('', service_name)
        AND $otel_scope_name in ('', otel_scope_name)
        AND $span_name in ('', span_name)
        AND $exception_type in ('', exception_type)
    GROUP BY 1, 2, 3, 4, 5, 6
),
-- Step 2: Calculate sums needed for ranking within each pattern.
-- A pattern is (service_name, otel_scope_name, span_name, exception_type).
PatternSums AS (
    SELECT
        *, -- Selects all columns from UniqueErrorCounts
        -- Total count for the overall pattern
        SUM(specific_count) OVER (PARTITION BY service_name, otel_scope_name, span_name, exception_type) as pattern_total_count,
        -- Total count for each distinct message within the pattern
        SUM(specific_count) OVER (PARTITION BY service_name, otel_scope_name, span_name, exception_type, message) as message_total_within_pattern,
        -- Total count for each distinct exception_message within the pattern
        SUM(specific_count) OVER (PARTITION BY service_name, otel_scope_name, span_name, exception_type, exception_message) as ex_message_total_within_pattern
    FROM UniqueErrorCounts
),
-- Step 3: Rank distinct messages and exception_messages within each pattern based on their total counts.
-- Also generate row numbers to pick a single representative row for aggregation.
RankedPatternComponents AS (
    SELECT
        *, -- Selects all columns from PatternSums
        -- Rank distinct messages within the pattern
        DENSE_RANK() OVER (PARTITION BY service_name, otel_scope_name, span_name, exception_type ORDER BY message_total_within_pattern DESC, message) as message_rank_in_pattern,
        -- Row number to pick one row per distinct message for aggregation string
        ROW_NUMBER() OVER (PARTITION BY service_name, otel_scope_name, span_name, exception_type, message ORDER BY specific_count DESC, exception_message) as rn_for_message_agg,
        -- Rank distinct exception_messages within the pattern
        DENSE_RANK() OVER (PARTITION BY service_name, otel_scope_name, span_name, exception_type ORDER BY ex_message_total_within_pattern DESC, exception_message) as ex_message_rank_in_pattern,
        -- Row number to pick one row per distinct exception_message for aggregation string
        ROW_NUMBER() OVER (PARTITION BY service_name, otel_scope_name, span_name, exception_type, exception_message ORDER BY specific_count DESC, message) as rn_for_ex_message_agg
    FROM PatternSums
),
-- Step 4.1: Create aggregated string for top 5 messages for each pattern.
AggregatedMessages AS (
    SELECT
        service_name, otel_scope_name, span_name, exception_type,
        CASE
            WHEN COUNT(DISTINCT message) = 1 THEN MIN(message) -- If only one distinct message, show it directly
            ELSE STRING_AGG( '(' || message_total_within_pattern || ') ' || message, E'\\n' ORDER BY message_rank_in_pattern ) FILTER (WHERE message_rank_in_pattern <= 10 AND rn_for_message_agg = 1)
        END as aggregated_message_output
    FROM RankedPatternComponents
    GROUP BY 1, 2, 3, 4
),
-- Step 4.2: Create aggregated string for top 5 exception_messages for each pattern.
AggregatedExceptionMessages AS (
    SELECT
        service_name, otel_scope_name, span_name, exception_type,
        CASE
            WHEN COUNT(DISTINCT exception_message) = 1 THEN MIN(exception_message) -- If only one distinct ex_message, show it directly
            ELSE STRING_AGG( '(' || ex_message_total_within_pattern || ') ' || exception_message, E'\\n' ORDER BY ex_message_rank_in_pattern ) FILTER (WHERE ex_message_rank_in_pattern <= 10 AND rn_for_ex_message_agg = 1)
        END as aggregated_ex_message_output
    FROM RankedPatternComponents
    GROUP BY 1, 2, 3, 4
)
-- Step 5: Combine aggregated results, order by overall pattern count, and limit
SELECT
    base.pattern_total_count as count,
    base.service_name,
    base.otel_scope_name,
    base.span_name,
    COALESCE(m.aggregated_message_output, '') as message,
    base.exception_type,
    COALESCE(ex.aggregated_ex_message_output, '') as exception_message,
    'service_name = ''' || REPLACE(base.service_name, '''', '''''') || ''' AND otel_scope_name = ''' || REPLACE(base.otel_scope_name, '''', '''''') || ''' AND span_name = ''' || REPLACE(base.span_name, '''', '''''') || ''' AND exception_type = ''' || REPLACE(base.exception_type, '''', '''''') || '''' as "SQL filter to copy to Live View"
FROM ( -- Select distinct patterns and their total counts
    SELECT DISTINCT
        pattern_total_count,
        service_name, otel_scope_name, span_name, exception_type
    FROM RankedPatternComponents
) base
LEFT JOIN AggregatedMessages m
    ON base.service_name = m.service_name AND base.otel_scope_name = m.otel_scope_name AND
       base.span_name = m.span_name AND base.exception_type = m.exception_type
LEFT JOIN AggregatedExceptionMessages ex
    ON base.service_name = ex.service_name AND base.otel_scope_name = ex.otel_scope_name AND
       base.span_name = ex.span_name AND base.exception_type = ex.exception_type
ORDER BY count DESC
LIMIT 100`,groupBy:"",metrics:[]}}}}]}}},layouts:[{kind:"Grid",spec:{display:{title:" Exceptions",collapse:{open:!0}},items:[{x:0,y:0,width:24,height:13,content:{$ref:"#/spec/panels/Exceptions"}}]}}],variables:[{kind:"ListVariable",spec:{name:"errors_only",display:{name:"Errors only",description:"'Yes' means requiring `level >= 'error'`, which is the norm, but it's possible to log an exception at any level"},defaultValue:"Yes",allowMultiple:!1,allowAllValue:!1,plugin:{kind:"StaticListVariable",spec:{values:[{label:"Yes",value:"Yes"},{label:"No",value:"No"}]}}}},{kind:"TextVariable",spec:{name:"service_name",display:{name:"service_name",hidden:!1},value:""}},{kind:"TextVariable",spec:{name:"otel_scope_name",value:""}},{kind:"TextVariable",spec:{name:"span_name",display:{name:"span_name"},value:""}},{kind:"TextVariable",spec:{name:"exception_type",display:{name:"exception_type"},value:""}},{kind:"ListVariable",spec:{name:"resolution",display:{name:"Resolution",hidden:!0},defaultValue:"15 minutes",allowMultiple:!1,allowAllValue:!1,plugin:{kind:"TimeBucketVariable",spec:{}}}}]}},{id:"standard-usage-overview-dashboard",slug:"usage-overview",spec:{duration:"1h",display:{name:"Usage Overview",description:"Shows total volume of metrics and logs, broken down by service, span, and metric name."},variables:[{kind:"ListVariable",spec:{name:"group_by_env",display:{name:"Group by environment"},defaultValue:"Yes",allowMultiple:!1,allowAllValue:!1,plugin:{kind:"StaticListVariable",spec:{values:[{label:"Yes",value:"Yes"},{label:"No",value:"No"}]}}}},{kind:"ListVariable",spec:{name:"group_by_service",display:{name:"Group by service"},defaultValue:"Yes",allowMultiple:!1,allowAllValue:!1,plugin:{kind:"StaticListVariable",spec:{values:[{label:"Yes",value:"Yes"},{label:"No",value:"No"}]}}}},{kind:"ListVariable",spec:{name:"group_by_scope",display:{name:"Group by scope"},defaultValue:"Yes",allowMultiple:!1,allowAllValue:!1,plugin:{kind:"StaticListVariable",spec:{values:[{label:"Yes",value:"Yes"},{label:"No",value:"No"}]}}}},{kind:"TextVariable",spec:{name:"resolution",display:{name:"resolution",hidden:!0},value:"1 minute"}}],panels:{chart_8_0130gb:{kind:"Panel",spec:{display:{name:"Combined high level breakdown"},plugin:{kind:"Table",spec:{query:""}},queries:[{kind:"NonTimeSeriesQuery",spec:{plugin:{kind:"LogfireNonTimeSeriesQuery",spec:{query:`SELECT *
FROM (
    SELECT
        CASE WHEN $group_by_env = 'Yes' THEN deployment_environment ELSE '' END as Environment,
        CASE WHEN $group_by_service = 'Yes' THEN service_name ELSE '' END as Service,
        CASE WHEN $group_by_scope = 'Yes' THEN otel_scope_name ELSE '' END as Scope,
        'metrics' AS type,
        COUNT(1) / 1000000.0 AS millions
    FROM
        metrics
    GROUP BY
        Environment,
        Service,
        Scope,
        type

    UNION ALL

    SELECT
        CASE WHEN $group_by_env = 'Yes' THEN deployment_environment ELSE '' END as Environment,
        CASE WHEN $group_by_service = 'Yes' THEN service_name ELSE '' END as Service,
        CASE WHEN $group_by_scope = 'Yes' THEN otel_scope_name ELSE '' END as Scope,
        'records' AS type,
        COUNT(1) / 1000000.0 AS millions
    FROM
        records_all
    GROUP BY
        Environment,
        Service,
        Scope,
        type
) AS combined
ORDER BY
    millions DESC;
`,groupBy:"",metrics:[]}}}}]}},"chart_9 + 1744635680911":{kind:"Panel",spec:{display:{name:"Breakdown of records by span_name"},plugin:{kind:"Table",spec:{query:""}},queries:[{kind:"NonTimeSeriesQuery",spec:{plugin:{kind:"LogfireNonTimeSeriesQuery",spec:{query:`SELECT
    CASE WHEN $group_by_env = 'Yes' THEN deployment_environment ELSE '' END as Environment,
    CASE WHEN $group_by_service = 'Yes' THEN service_name ELSE '' END as Service,
    CASE WHEN $group_by_scope = 'Yes' THEN otel_scope_name ELSE '' END as Scope,
    span_name,
    COUNT(1) / 1000000.0 AS millions
FROM
    records_all
GROUP BY
    Environment,
    Service,
    Scope,
    span_name
ORDER BY
    millions DESC;`,groupBy:"",metrics:[]}}}}]}},"chart_10 + 1744635790166":{kind:"Panel",spec:{display:{name:"Breakdown of metrics by metric_name"},plugin:{kind:"Table",spec:{query:""}},queries:[{kind:"NonTimeSeriesQuery",spec:{plugin:{kind:"LogfireNonTimeSeriesQuery",spec:{query:`SELECT
    CASE WHEN $group_by_env = 'Yes' THEN deployment_environment ELSE '' END as Environment,
    CASE WHEN $group_by_service = 'Yes' THEN service_name ELSE '' END as Service,
    CASE WHEN $group_by_scope = 'Yes' THEN otel_scope_name ELSE '' END as Scope,
    metric_name,
    COUNT(1) / 1000000.0 AS millions
FROM
    metrics
GROUP BY
    Environment,
    Service,
    Scope,
    metric_name
ORDER BY
    millions DESC;`,groupBy:"",metrics:[]}}}}]}}},layouts:[{kind:"Grid",spec:{display:{title:"Usage overview",collapse:{open:!0}},items:[{x:0,y:0,width:24,height:8,content:{$ref:"#/spec/panels/chart_8_0130gb"}},{x:0,y:8,width:24,height:8,content:{$ref:"#/spec/panels/chart_9 + 1744635680911"}},{x:0,y:16,width:24,height:8,content:{$ref:"#/spec/panels/chart_10 + 1744635790166"}}]}}]}},{id:"standard-web-server-metrics-dashboard",slug:"web-server-metrics",spec:{display:{name:"Web Server Metrics",description:"Tracks request durations and response counts per route and endpoint to spot slow or error-prone paths."},panels:{TotalDurationByRouteBar:{kind:"Panel",spec:{display:{name:"Total duration in seconds by route (Top 10)"},plugin:{kind:"BarChart",spec:{mode:"value",sort:"none",format:{unit:"seconds",shortValues:!0,decimalPlaces:2},calculation:"last"}},queries:[{kind:"NonTimeSeriesQuery",spec:{plugin:{kind:"LogfireNonTimeSeriesQuery",spec:{query:`WITH dataset AS (
    SELECT
        ROUND(SUM(histogram_sum) / 1000, 2) AS amount,
        (
            COALESCE(attributes ->> 'http.route', attributes ->> 'http.target')
        ) AS endpoint
    FROM metrics
    WHERE metric_name in ('http.server.duration', 'http.server.request.duration') and aggregation_temporality = 'delta'
    GROUP BY endpoint
    HAVING endpoint is not null
    ORDER BY amount DESC
    LIMIT 10
)
SELECT
    endpoint as "Route", amount as "Total Duration"
FROM dataset
ORDER BY amount ASC`,groupBy:"",metrics:[]}}}}]}},AvgDurationByRouteBar:{kind:"Panel",spec:{display:{name:"Average duration in seconds by route (Top 10)"},plugin:{kind:"BarChart",spec:{mode:"value",sort:"none",format:{unit:"seconds",shortValues:!0,decimalPlaces:2},calculation:"last"}},queries:[{kind:"NonTimeSeriesQuery",spec:{plugin:{kind:"LogfireNonTimeSeriesQuery",spec:{query:`WITH dataset AS (
    SELECT
        ROUND(SUM(histogram_sum) / SUM(histogram_count) / 1000, 2) AS amount,
        (
            COALESCE(attributes ->> 'http.route', attributes ->> 'http.target')
        ) AS endpoint
    FROM metrics
    WHERE metric_name in ('http.server.duration', 'http.server.request.duration') and aggregation_temporality = 'delta'
    GROUP BY endpoint
    HAVING endpoint is not null AND SUM(histogram_count) > 0
    ORDER BY amount DESC
    LIMIT 10
)
SELECT
    endpoint as "Route", amount as "Average Duration"
FROM dataset
ORDER BY amount ASC`,groupBy:"",metrics:[]}}}}]}},TotalDurationByEndpointTS:{kind:"Panel",spec:{display:{name:"Total duration in seconds by service and endpoint (Top 5 per interval)"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},yAxis:{show:!0,label:"Seconds",format:{unit:"seconds",decimalPlaces:2}},visual:{display:"line",areaOpacity:.25}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`WITH dataset AS (
    SELECT
        time_bucket($resolution, recorded_timestamp) AS x,
        ROUND(SUM(histogram_sum) / 1000, 2) AS amount,
        (
            CASE WHEN service_namespace = '' OR service_namespace IS NULL THEN '' ELSE service_namespace || ' ' END ||
            CASE WHEN service_name in ('', 'unknown_service') OR service_name IS NULL THEN '' ELSE service_name || ' ' END ||
            COALESCE(attributes ->> 'http.request.method', attributes ->> 'http.method') || ' ' ||
            COALESCE(attributes ->> 'http.route', attributes ->> 'http.target')
        ) AS endpoint
    FROM metrics
    WHERE metric_name in ('http.server.duration', 'http.server.request.duration') and aggregation_temporality = 'delta'
    GROUP BY x, endpoint
    HAVING endpoint is not null
),
ranked AS (
    SELECT
        x,
        amount,
        endpoint,
        ROW_NUMBER() OVER (PARTITION BY x ORDER BY amount DESC) AS row_num
    FROM dataset
)
SELECT
    x,
    amount,
    endpoint
FROM ranked
WHERE row_num <= 5
ORDER BY x;`,groupBy:"endpoint",metrics:["amount"]}}}}]}},AvgDurationByEndpointTS:{kind:"Panel",spec:{display:{name:"Average duration in seconds by service and endpoint (Top 5 per interval)"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},yAxis:{show:!0,label:"Seconds",format:{unit:"seconds",decimalPlaces:2}},visual:{display:"line",areaOpacity:.25}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`WITH dataset AS (
    SELECT
        time_bucket($resolution, recorded_timestamp) AS x,
        ROUND(SUM(histogram_sum) / SUM(histogram_count) / 1000, 2) AS amount,
        (
            CASE WHEN service_namespace = '' OR service_namespace IS NULL THEN '' ELSE service_namespace || ' ' END ||
            CASE WHEN service_name in ('', 'unknown_service') OR service_name IS NULL THEN '' ELSE service_name || ' ' END ||
            COALESCE(attributes ->> 'http.request.method', attributes ->> 'http.method') || ' ' ||
            COALESCE(attributes ->> 'http.route', attributes ->> 'http.target')
        ) AS endpoint
    FROM metrics
    WHERE metric_name in ('http.server.duration', 'http.server.request.duration') and aggregation_temporality = 'delta'
    GROUP BY x, endpoint
    HAVING endpoint is not null AND SUM(histogram_count) > 0
),
ranked AS (
    SELECT
        x,
        amount,
        endpoint,
        ROW_NUMBER() OVER (PARTITION BY x ORDER BY amount DESC) AS row_num
    FROM dataset
)
SELECT
    x,
    amount,
    endpoint
FROM ranked
WHERE row_num <= 5
ORDER BY x;`,groupBy:"endpoint",metrics:["amount"]}}}}]}},Requests2xxByEndpointTS:{kind:"Panel",spec:{display:{name:"2xx request count by service and endpoint (Top 5 per interval)"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},yAxis:{show:!0,label:"Count"},visual:{display:"line",areaOpacity:.25}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`WITH dataset AS (
    SELECT
