    -- Select 1 row for each unique process existing in each time bucket.
    -- Note that if many processes get started and stopped within a time bucket then they will all be counted,
    -- leading to a high process count even if their lifetimes didn't overlap.
    -- This means that large time buckets can give misleading results.
    SELECT DISTINCT
        time_bucket($resolution, recorded_timestamp) AS time,
        service_namespace,
        service_name,
        service_instance_id,
        process_pid
    -- These columns/attributes exist for all spans/metrics coming from the logfire SDK, so we could use anything here.
    -- This particular filter just narrows the number of rows down nicely.
    -- The only caveat is that it relies on system metrics being collected,
    -- but of course that applies to all charts in this dashboard.
    FROM metrics
    WHERE metric_name = 'system.memory.utilization'
)

SELECT
    time,
    CASE WHEN service_namespace = '' THEN service_name ELSE service_namespace || ': ' || service_name END AS service_name,
    COUNT(1) AS processes
FROM distinct_processes
GROUP BY time, service_name, service_namespace
ORDER BY time DESC;`,groupBy:"service_name",metrics:["processes"]}}}}]}},SystemCpuUsagePercent:{kind:"Panel",spec:{display:{name:"System CPU usage %"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},yAxis:{show:!0,label:"%",format:{unit:"percent",suffix:"%",decimalPlaces:1}},visual:{display:"line",areaOpacity:.25}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
    time_bucket($resolution, recorded_timestamp) AS time,
    ROUND(AVG(scalar_value)::numeric * 100, 1) AS "CPU %",
    CASE WHEN service_namespace = '' THEN service_name ELSE service_namespace || ': ' || service_name END AS service_name
FROM metrics
-- This is a metric created specifically by Logfire
WHERE metric_name = 'system.cpu.simple_utilization'
-- This assumes that prcoesses are evenly distributed across hosts,
-- and that all hosts have the same total amount of CPU cores/capacity available.
-- Otherwise the average will be skewed.
GROUP BY time, service_namespace, service_name
ORDER BY time DESC;`,groupBy:"service_name",metrics:["CPU %"]}}}}]}},ProcessCpuUsagePercent:{kind:"Panel",spec:{display:{name:"Process CPU usage %"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},yAxis:{show:!0,label:"%",format:{unit:"percent",suffix:"%",decimalPlaces:1}},visual:{display:"line",areaOpacity:.25}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
    time_bucket($resolution, recorded_timestamp) AS time,
    ROUND(
        AVG(scalar_value)::numeric * (
            -- The spec requires that a value of 1 means 100%, but the OTEL Python library got this wrong:
            -- https://github.com/open-telemetry/opentelemetry-python-contrib/issues/2810
            -- So logfire reimplements this metric with the correct range.
            -- If the chart is showing values that are 100x too high/low, then either:
            -- (1) Your version of the logfire SDK is older than your version of the opentelemetry.instrumentation.system_metrics package,
            -- (2) Another instrumentation library is using the 'opentelemetry.instrumentation.system_metrics' scope, or
            -- (3) Another instrumentation library is getting the values wrong.
            -- Keep in mind that this metric CAN be higher than 100% if a process is using multiple cores.
            CASE
                WHEN otel_scope_name = 'opentelemetry.instrumentation.system_metrics'
                THEN 1
                ELSE 100
            END
        ),
    1) AS "CPU %",
    CASE WHEN service_namespace = '' THEN service_name ELSE service_namespace || ': ' || service_name END AS service_name
FROM metrics
WHERE
    -- process.cpu.core_utilization is a custom logfire metric
    -- to replace process.runtime.%.cpu.utilization which has been deprecated by OTel.
    -- The new OTel metric process.cpu.utilization divides by the number of cores which is less useful for this dashboard.
    metric_name = 'process.cpu.core_utilization' or
    metric_name like 'process.runtime.%.cpu.utilization'  -- e.g. process.runtime.cpython.cpu.utilization
GROUP BY time, service_namespace, service_name, otel_scope_name
ORDER BY time DESC;`,groupBy:"service_name",metrics:["CPU %"]}}}}]}},MemoryUsagePercent:{kind:"Panel",spec:{display:{name:"Memory usage %"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},yAxis:{show:!0,label:"%",format:{unit:"percent",suffix:"%",decimalPlaces:1}},visual:{display:"line",areaOpacity:.25}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
    time_bucket($resolution, recorded_timestamp) AS time,
    -- This essentially calculates the 'percent' field described in
    -- https://psutil.readthedocs.io/en/latest/index.html#psutil.virtual_memory
    -- \`system.memory.utilization\` (in contrast to \`system.memory.usage\`) is a ratio between 0 and 1.
    ROUND((1 - AVG(scalar_value)::numeric) * 100, 1) AS "Memory used %",
    CASE WHEN service_namespace = '' THEN service_name ELSE service_namespace || ': ' || service_name END AS service_name
FROM metrics
WHERE metric_name = 'system.memory.utilization'
  -- From https://psutil.readthedocs.io/en/latest/index.html#psutil.virtual_memory:
  -- > *available*: the memory that can be given instantly to processes without the system going into swap.
  -- > This is calculated by summing different memory metrics that vary depending on the platform.
  -- > It is supposed to be used to monitor actual memory usage in a cross platform fashion.
  AND attributes->>'state' = 'available'
-- Like the CPU chart, this assumes that prcoesses are evenly distributed across hosts,
-- and that all hosts have the same total amount of memory available.
-- Otherwise the average will be skewed.
GROUP BY time, service_namespace, service_name
ORDER BY time DESC;`,groupBy:"service_name",metrics:["Memory used %"]}}}}]}},SwapUsagePercent:{kind:"Panel",spec:{display:{name:"Swap usage % (will be empty if no services have swap)"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},yAxis:{show:!0,label:"%",format:{unit:"percent",suffix:"%",decimalPlaces:1}},visual:{display:"line",areaOpacity:.25}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
    time_bucket($resolution, recorded_timestamp) AS time,
    ROUND(AVG(scalar_value)::numeric * 100, 1) AS "Swap used %",
    CASE WHEN service_namespace = '' THEN service_name ELSE service_namespace || ': ' || service_name END AS service_name
FROM metrics
WHERE metric_name = 'system.swap.utilization'
-- This assumes that prcoesses are evenly distributed across hosts,
-- and that all hosts have the same total amount of swap available.
-- Otherwise the average will be skewed.
GROUP BY time, service_namespace, service_name
ORDER BY time DESC;`,groupBy:"service_name",metrics:["Swap used %"]}}}}]}}},layouts:[{kind:"Grid",spec:{display:{title:"System Metrics",collapse:{open:!0}},items:[{x:0,y:0,width:24,height:8,content:{$ref:"#/spec/panels/ProcessCount"}},{x:0,y:8,width:24,height:8,content:{$ref:"#/spec/panels/SystemCpuUsagePercent"}},{x:0,y:16,width:24,height:8,content:{$ref:"#/spec/panels/ProcessCpuUsagePercent"}},{x:0,y:24,width:24,height:8,content:{$ref:"#/spec/panels/MemoryUsagePercent"}},{x:0,y:32,width:24,height:8,content:{$ref:"#/spec/panels/SwapUsagePercent"}}]}}]}},{id:"standard-basic-service-metrics-opentelemetry-dashboard",slug:"basic-service-metrics-opentelemetry",spec:{duration:"1h",display:{name:"Basic System Metrics (OpenTelemetry)",description:"Displays essential system resource utilization metrics using data exported by any OpenTelemetry-based instrumentation."},variables:[],panels:{ProcessCountOTel:{kind:"Panel",spec:{display:{name:"Process count"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},yAxis:{show:!0,label:"Count"},visual:{display:"line",areaOpacity:.25}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`WITH distinct_processes AS (
    -- Select 1 row for each unique process existing in each time bucket.
    -- Note that if many processes get started and stopped within a time bucket then they will all be counted,
    -- leading to a high process count even if their lifetimes didn't overlap.
    -- This means that large time buckets can give misleading results.
    SELECT DISTINCT
        time_bucket($resolution, recorded_timestamp) AS time,
        service_namespace,
        service_name,
        service_instance_id,
        process_pid
    -- These columns/attributes exist for all spans/metrics coming from the logfire SDK, so we could use anything here.
    -- This particular filter just narrows the number of rows down nicely.
    -- The only caveat is that it relies on system metrics being collected,
    -- but of course that applies to all charts in this dashboard.
    FROM metrics
    WHERE metric_name = 'system.memory.utilization'
)

SELECT
    time,
    CASE WHEN service_namespace = '' THEN service_name ELSE service_namespace || ': ' || service_name END AS service_name,
    COUNT(1) AS processes
FROM distinct_processes
GROUP BY time, service_name, service_namespace
ORDER BY time DESC;`,groupBy:"service_name",metrics:["processes"]}}}}]}},SystemCpuUsagePercentOTel:{kind:"Panel",spec:{display:{name:"System CPU usage %"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},yAxis:{show:!0,label:"%",format:{unit:"percent",suffix:"%",decimalPlaces:1}},visual:{display:"line",areaOpacity:.25}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`WITH by_cpu AS (
    SELECT
        -- Add up all the different 'busy' CPU states for each process at each point in time.
        -- To get an accurate total, the SDK must export all states except for 'guest' and 'guest_nice'
        -- which are included in 'user' and 'nice' in Linux (see psutil._cpu_tot_time).
        SUM(scalar_value) as "CPU %",
        recorded_timestamp,
        service_namespace,
        service_name
    FROM metrics
    WHERE
        metric_name = 'system.cpu.utilization'
        -- Leave out non-busy states.
        AND attributes ->> 'state' not in ('idle', 'iowait', 'wait')
    GROUP BY
        recorded_timestamp,
        -- Group by these columns to get a separate total for each process and CPU core.
        -- Ideally we would only group by something like host/machine since we're measuring total CPU usage,
        -- but there isn't a reliable attribute for that right now.
        -- This should still usually work fine since we're taking the average of the measurements from each process.
        -- The results will only be skewed if processes or CPU cores are not evenly distributed across hosts.
        -- This also assumes that all CPU cores are equally powerful and available for usage.
        service_namespace,
        service_name,
        service_instance_id,
        attributes->>'cpu'
)

SELECT
    time_bucket($resolution, recorded_timestamp) AS time,
    ROUND(AVG("CPU %")::numeric * 100, 1) AS "CPU %",
    CASE WHEN service_namespace = '' THEN service_name ELSE service_namespace || ': ' || service_name END AS service_name
FROM by_cpu
GROUP BY time, service_name, service_namespace
ORDER BY time desc`,groupBy:"service_name",metrics:["CPU %"]}}}}]}},ProcessCpuUsagePercentOTel:{kind:"Panel",spec:{display:{name:"Process CPU usage %"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},yAxis:{show:!0,label:"%",format:{unit:"percent",suffix:"%",decimalPlaces:1}},visual:{display:"line",areaOpacity:.25}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
    time_bucket($resolution, recorded_timestamp) AS time,
    ROUND(
        AVG(scalar_value)::numeric * (
            -- The spec requires that a value of 1 means 100%, but the OTEL Python library got this wrong:
            -- https://github.com/open-telemetry/opentelemetry-python-contrib/issues/2810
            -- So logfire reimplements this metric with the correct range.
            -- If the chart is showing values that are 100x too high/low, then either:
            -- (1) Your version of the logfire SDK is older than your version of the opentelemetry.instrumentation.system_metrics package,
            -- (2) Another instrumentation library is using the 'opentelemetry.instrumentation.system_metrics' scope, or
            -- (3) Another instrumentation library is getting the values wrong.
            -- Keep in mind that this metric CAN be higher than 100% if a process is using multiple cores.
            CASE
                WHEN otel_scope_name = 'opentelemetry.instrumentation.system_metrics'
                THEN 1
                ELSE 100
            END
        ),
    1) AS "CPU %",
    CASE WHEN service_namespace = '' THEN service_name ELSE service_namespace || ': ' || service_name END AS service_name
FROM metrics
-- The metrics will have names like \`process.runtime.cpython.cpu.utilization\`
WHERE metric_name like 'process.runtime.%.cpu.utilization'
GROUP BY time, service_namespace, service_name, otel_scope_name
ORDER BY time DESC;`,groupBy:"service_name",metrics:["CPU %"]}}}}]}},MemoryUsagePercentOTel:{kind:"Panel",spec:{display:{name:"Memory usage %"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},yAxis:{show:!0,label:"%",format:{unit:"percent",suffix:"%",decimalPlaces:1}},visual:{display:"line",areaOpacity:.25}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
    time_bucket($resolution, recorded_timestamp) AS time,
    -- This essentially calculates the 'percent' field described in
    -- https://psutil.readthedocs.io/en/latest/index.html#psutil.virtual_memory
    -- \`system.memory.utilization\` (in contrast to \`system.memory.usage\`) is a ratio between 0 and 1.
    ROUND((1 - AVG(scalar_value)::numeric) * 100, 1) AS "Memory used %",
    CASE WHEN service_namespace = '' THEN service_name ELSE service_namespace || ': ' || service_name END AS service_name
FROM metrics
WHERE metric_name = 'system.memory.utilization'
  -- From https://psutil.readthedocs.io/en/latest/index.html#psutil.virtual_memory:
  -- > *available*: the memory that can be given instantly to processes without the system going into swap.
  -- > This is calculated by summing different memory metrics that vary depending on the platform.
  -- > It is supposed to be used to monitor actual memory usage in a cross platform fashion.
  AND attributes->>'state' = 'available'
-- Like the CPU chart, this assumes that prcoesses are evenly distributed across hosts,
-- and that all hosts have the same total amount of memory available.
-- Otherwise the average will be skewed.
GROUP BY time, service_namespace, service_name
ORDER BY time DESC;`,groupBy:"service_name",metrics:["Memory used %"]}}}}]}},SwapUsagePercentOTel:{kind:"Panel",spec:{display:{name:"Swap usage % (will be empty if no services have swap)"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},yAxis:{show:!0,label:"%",format:{unit:"percent",suffix:"%",decimalPlaces:1}},visual:{display:"line",areaOpacity:.25}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`WITH swap_rows AS (
  SELECT
    scalar_value,
    recorded_timestamp AS time,
    service_namespace,
    service_name,
    -- Like the CPU chart, this assumes that prcoesses are evenly distributed across hosts for each service_name.
    -- Otherwise the average will be skewed.
    service_instance_id,
    attributes ->> 'state' AS state
  FROM metrics
  -- Using swap.usage instead of swap.utilization means that we don't have to assume
  -- that different hosts have the same amount of swap space.
  WHERE metric_name = 'system.swap.usage'
),

swap_rows_used AS ( SELECT * FROM swap_rows WHERE state = 'used' ),
swap_rows_free AS ( SELECT * FROM swap_rows WHERE state = 'free' ),

joined AS (
  SELECT
    swap_rows_used.scalar_value AS swap_used,
    swap_rows_free.scalar_value AS swap_free,
    swap_rows_used.service_namespace,
    swap_rows_used.service_name,
    swap_rows_used.time
  FROM
    swap_rows_used JOIN
    swap_rows_free ON (
      swap_rows_used.service_name =
      swap_rows_free.service_name
        AND
      swap_rows_used.time =
      swap_rows_free.time
        AND
      swap_rows_used.service_instance_id =
      swap_rows_free.service_instance_id
    )
),

grouped AS (
  SELECT
    time_bucket($resolution, time) AS time_bucket,
    SUM(swap_used)::numeric AS total_used,
    SUM(swap_free)::numeric AS total_free,
    service_namespace,
    service_name
  FROM joined
  GROUP BY time_bucket, service_namespace, service_name
)

SELECT
  ROUND(total_used / (total_used + total_free) * 100, 1) AS "Swap used %",
  time_bucket,
  CASE WHEN service_namespace = '' THEN service_name ELSE service_namespace || ': ' || service_name END AS service_name
FROM grouped
WHERE total_used + total_free > 0  -- Avoid division by zero
ORDER BY time_bucket DESC;`,groupBy:"service_name",metrics:["Swap used %"]}}}}]}}},layouts:[{kind:"Grid",spec:{display:{title:"System Metrics (OpenTelemetry)",collapse:{open:!0}},items:[{x:0,y:0,width:24,height:8,content:{$ref:"#/spec/panels/ProcessCountOTel"}},{x:0,y:8,width:24,height:8,content:{$ref:"#/spec/panels/SystemCpuUsagePercentOTel"}},{x:0,y:16,width:24,height:8,content:{$ref:"#/spec/panels/ProcessCpuUsagePercentOTel"}},{x:0,y:24,width:24,height:8,content:{$ref:"#/spec/panels/MemoryUsagePercentOTel"}},{x:0,y:32,width:24,height:8,content:{$ref:"#/spec/panels/SwapUsagePercentOTel"}}]}}]}}],vv={id:zo,slug:"logfire-meta",spec:{duration:"1h",display:{name:"Logfire Meta",description:"Logfire meta self-hosted dashboard, can't be disabled for logfire-meta org"},panels:{Harddeletes:{kind:"Panel",spec:{display:{name:"Hard deletes"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`select
        time_bucket($resolution, start_timestamp) as x,
        sum((attributes->>'files')::integer) as deleted_count
      from records
        where span_name = 'deleting {files} files'
        and service_name = '${Xe}'
      group by 1;
      `}}}}]}},FileLifetime:{kind:"Panel",spec:{display:{name:"File Lifetime"},plugin:{kind:"TimeSeriesChart",spec:{yAxis:{show:!0,label:"",format:{unit:"seconds",decimalPlaces:2}},visual:{areaOpacity:.3,connectNulls:!0},thresholds:{}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`select
          time_bucket($resolution, start_timestamp) AS x,
          concat(attributes->>'tier_lower_bound','-',attributes->>'tier_upper_bound') as max_size,
          sum(histogram_sum) / sum(histogram_count)
      from metrics
      where
          service_name = '${et}'
          AND metric_name = 'file_lifetime_seconds'
      group by x,max_size
      `,groupBy:"max_size",metrics:["sum(metrics.histogram_sum) / sum(metrics.histogram_count)"]}}}}]}},Compactionrate:{kind:"Panel",spec:{display:{name:"Compaction rate - bytes"},plugin:{kind:"TimeSeriesChart",spec:{yAxis:{show:!0,label:"",format:{unit:"bytes"}},legend:{position:"bottom"}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        sum(CASE when metric_name = 'compaction_bytes_in' THEN scalar_value else 0 END) AS bytes_in,
        sum(CASE when metric_name = 'compaction_bytes_out' THEN scalar_value else 0 END) AS bytes_out
      FROM metrics
      WHERE metric_name in ('compaction_bytes_in', 'compaction_bytes_out')
      GROUP BY x
      ORDER BY x DESC;
          `}}}}]}},Eventlooppauses:{kind:"Panel",spec:{display:{name:"Total"},plugin:{kind:"TimeSeriesChart",spec:{yAxis:{show:!0,label:"",format:{unit:"milliseconds"}},legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`with data as (
        select
          regexp_match(message,'(\\d+\\.?\\d*)ms')[1]::numeric as pause_ms,
          start_timestamp,
          service_name
        from records
        where span_name='event loop pause of {extra:?} detected on thread {thread_name}'
        and level = 'warn'
      )
      select time_bucket($resolution, start_timestamp) AS x, service_name,
        sum(pause_ms)
      from data
      GROUP BY x, service_name;`,groupBy:"service_name",metrics:["sum(data.pause_ms)"]}}}}]}},"Eventlooppauses-1":{kind:"Panel",spec:{display:{name:"P95"},plugin:{kind:"TimeSeriesChart",spec:{yAxis:{show:!0,label:"",format:{unit:"milliseconds"}},legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`with data as (
        select
          regexp_match(message,'(\\d+\\.?\\d*)ms')[1]::numeric as pause_ms,
          start_timestamp,
          service_name
        from records
        where span_name='event loop pause of {extra:?} detected on thread {thread_name}'
        and level = 'warn'
      )
      select time_bucket($resolution, start_timestamp) AS x, service_name,
        approx_percentile_cont(0.95) WITHIN GROUP (ORDER BY pause_ms) as P95
      from data
      GROUP BY x, service_name;`,groupBy:"service_name",metrics:["p95"]}}}}]}},"Ingest-queuein/out":{kind:"Panel",spec:{display:{name:"Ingest - queue in / out"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        sum(CASE when metric_name like 'logfire.%.ingest_request_count' THEN scalar_value else 0 END) AS ingest_requests_in,
        sum(CASE when metric_name = 'ingest_batch_count' THEN scalar_value else 0 END) AS ingest_batches_out
      FROM metrics
      WHERE metric_name like 'logfire.%.ingest_request_count'
      OR metric_name in ('ingest_batch_count')
      GROUP BY x
      ORDER BY x DESC;
          `}}}}]}},IngestWriteLatency:{kind:"Panel",spec:{display:{name:"Ingest Write Latency"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
          time_bucket($resolution, start_timestamp) AS x,
          (sum(histogram_sum) / sum(histogram_count)) as mean_latency_ms,
          max(histogram_max) as max_latency_ms
      FROM metrics
      where metric_name = 'sqlite_insert_ingest_payload_latency_ms'
      GROUP BY x
      ORDER BY x DESC;`,metrics:["max_latency_seconds_ms","mean_latency_ms","max_latency_ms"]}}}}]}},"Compactionrate-jobs":{kind:"Panel",spec:{display:{name:"Compaction rate - jobs"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        count(*) as num_jobs
      FROM records
      WHERE span_name = 'compact_files'
      AND service_name IN ('${Xe}', '${et}')
      GROUP BY x
      ORDER BY x DESC;
          `}}}}]}},Filespercompactionjob:{kind:"Panel",spec:{display:{name:"Files per compaction job"},plugin:{kind:"BarChart",spec:{mode:"value",sort:"desc",format:{unit:"decimal"},calculation:"last"}},queries:[{kind:"NonTimeSeriesQuery",spec:{plugin:{kind:"LogfireNonTimeSeriesQuery",spec:{query:`-- set ff.cache_arrow_ipc_chance = 0.0;
      select count(*),(attributes->>'file_count') as file_count from records where service_name IN ('${et}', '${Xe}') AND span_name = 'compact_files' group by file_count order by file_count::int`,groupBy:"",metrics:[]}}}}]}},IngestExportsperBatch:{kind:"Panel",spec:{display:{name:"Ingest Exports per Batch",description:"The number of batched exports that get ingested per loop. The larger the better, but often close to 1."},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        avg(histogram_sum / histogram_count) as avg_batch_size
      FROM metrics
      WHERE metric_name = 'ingest_batch_size'
      GROUP BY x;`}}}}]}},IngestSQLiteFreePageCount:{kind:"Panel",spec:{display:{name:"Ingest SQLite Free Page Count"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        otel_resource_attributes->>'k8s.pod.name' as pod_name,
        avg(scalar_value)
      FROM metrics
      WHERE metric_name = 'sqlite_free_list_size'
      GROUP BY x, pod_name`,groupBy:"pod_name",metrics:["avg(metrics.scalar_value)"]}}}}]}},"Ingest-meanandmaxlatency(s)":{kind:"Panel",spec:{display:{name:"Ingest - mean latency (s)"},plugin:{kind:"TimeSeriesChart",spec:{yAxis:{show:!0,label:"",format:{unit:"seconds"}},legend:{position:"bottom"}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
          time_bucket($resolution, start_timestamp) AS x,
          sum(histogram_sum) / sum(histogram_count) / 1000 as mean_latency
      FROM metrics
      where metric_name = 'ingest_queue_latency_ms'
      GROUP BY x
      ORDER BY x DESC;`}}}}]}},IngestQueueReadQueryLatency:{kind:"Panel",spec:{display:{name:"Ingest Queue Read Query Latency (ms)"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`-- In ingest we first try to grab payloads by batch / bucket
      -- But if we can't even fit a single batch / bucket into our max size
      -- then we fall back to row selection.
      -- So most of the time the row selection query shouldn't even run.
      WITH bucket_selection_query AS (
        SELECT
          time_bucket($resolution, start_timestamp) AS x,
          avg(histogram_sum / histogram_count) as batch_query_latency_ms
        FROM metrics
        WHERE metric_name = 'sqlite_get_next_batch_bucket_selection_latency_ms'
        GROUP BY x
      ), row_selection_query AS (
        SELECT
          time_bucket($resolution, start_timestamp) AS x,
          avg(histogram_sum / histogram_count) as row_query_latency_ms
        FROM metrics
        WHERE metric_name = 'sqlite_get_next_batch_row_selection_latency_ms'
        GROUP BY x
      )
      SELECT x, batch_query_latency_ms, row_query_latency_ms
      FROM bucket_selection_query
      JOIN row_selection_query USING (x)`,metrics:["batch_query_latency_ms","row_query_latency_ms"]}}}}]}},"Compactionrate-filesin,bypod":{kind:"Panel",spec:{display:{name:"Compaction rate - files in, by pod"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        otel_resource_attributes->>'k8s.pod.name' as pod,
        sum(scalar_value) AS value
      FROM metrics
      WHERE metric_name = 'compaction_files_in'
      GROUP BY x, pod
      ORDER BY x DESC;`,groupBy:"pod",metrics:["value"]}}}}]}},ActiveIngestAPIserverrequests:{kind:"Panel",spec:{display:{name:"Active Ingest API server requests",description:"The number of active HTTP requests"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        avg(scalar_value) AS avg_active_requests,
        max(scalar_value) AS max_active_requests,
        min(scalar_value) AS min_active_requests,
        count(*) AS data_points
      FROM metrics
      WHERE otel_scope_name = 'axum-otel-metrics'
        AND metric_name = 'http.server.active_requests'
        AND service_name = '${Wn}'
      GROUP BY x
      ORDER BY x DESC;`}}}}]}},"Ingest-meanandmaxlatency(s)-1":{kind:"Panel",spec:{display:{name:"Ingest - max latency (s)"},plugin:{kind:"TimeSeriesChart",spec:{yAxis:{show:!0,label:"",format:{unit:"seconds"}},legend:{position:"bottom"}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
          time_bucket($resolution, start_timestamp) AS x,
          otel_resource_attributes->>'k8s.pod.name' as pod_name,
          max(histogram_max) / 1000 as max_latency
      FROM metrics
      where metric_name = 'ingest_queue_latency_ms'
      GROUP BY x, pod_name
      ORDER BY x DESC;`,groupBy:"pod_name",metrics:["max_latency"]}}}}]}},"Compactionhealth-jobfailures-1":{kind:"Panel",spec:{display:{name:"Compaction health - job failures"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        count(*) as num_failed_jobs
      FROM records
      WHERE service_name IN ('${et}', '${Xe}')
      AND level >= 'error'
      GROUP BY x
      ORDER BY x DESC;`,metrics:["num_failed_jobs"]}}}}]}},"Compactionrate-files(w.ingest)":{kind:"Panel",spec:{display:{name:"Compaction rate - files (w.ingest)"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        sum(CASE when metric_name like 'logfire.%.ingest_request_count' THEN scalar_value else 0 END) AS ingest_requests_in,
        sum(CASE when metric_name = 'ingest_batch_count' THEN scalar_value else 0 END) AS ingest_batches_out,
        sum(CASE when metric_name = 'compaction_files_in' THEN scalar_value else 0 END) AS compaction_files_in,
        sum(CASE when metric_name = 'compaction_files_out' THEN scalar_value else 0 END) AS compaction_files_out
      FROM metrics
      WHERE metric_name like 'logfire.%.ingest_request_count'
      OR metric_name in ('ingest_batch_count', 'compaction_files_in', 'compaction_files_out')
      GROUP BY x
      ORDER BY x DESC;
          `}}}}]}},"Compactionhealth-jobfailuretypes":{kind:"Panel",spec:{display:{name:"Compaction health - job failure types"},plugin:{kind:"Table",spec:{query:""}},queries:[{kind:"NonTimeSeriesQuery",spec:{plugin:{kind:"LogfireNonTimeSeriesQuery",spec:{query:`SELECT
        COALESCE(split_part(attributes->>'error', E'\\n', 1), message) AS failure_type,
        count(*) as num_failed_jobs
      FROM records
      WHERE service_name IN ('${et}', '${Xe}')
      AND level = 'error'
      GROUP BY 1
      ORDER BY 2 DESC;
          `,groupBy:"",metrics:[]}}}}]}},"Compactionperformance-jobduratoin":{kind:"Panel",spec:{display:{name:"Compaction performance - job duration"},plugin:{kind:"TimeSeriesChart",spec:{yAxis:{show:!0,label:"",format:{unit:"seconds"}},legend:{position:"bottom"}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        mean(duration) as mean,
        max(duration) as max,
        approx_percentile_cont(0.5) WITHIN GROUP (ORDER BY duration) AS p50,
        approx_percentile_cont(0.9) WITHIN GROUP (ORDER BY duration) AS p90,
        approx_percentile_cont(0.99) WITHIN GROUP (ORDER BY duration) AS p99
      FROM records
      WHERE span_name = 'compact_files'
      AND service_name IN ('${Xe}', '${et}')
      GROUP BY x
      ORDER BY x DESC;`}}}}]}},"Compactionperformance-jobduratoin-1":{kind:"Panel",spec:{display:{name:"Compaction performance - job duration (Percentiles)"},plugin:{kind:"TimeSeriesChart",spec:{yAxis:{show:!0,label:"",format:{unit:"seconds"}},legend:{position:"bottom"}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        approx_percentile_cont(0.5) WITHIN GROUP (ORDER BY duration) AS p50,
        approx_percentile_cont(0.9) WITHIN GROUP (ORDER BY duration) AS p90,
        approx_percentile_cont(0.99) WITHIN GROUP (ORDER BY duration) AS p99
      FROM records
      WHERE span_name = 'compact_files'
      AND service_name IN ('${Xe}', '${et}')
      GROUP BY x
      ORDER BY x DESC;`}}}}]}},IngestTotalBytes:{kind:"Panel",spec:{display:{name:"Ingest Total Bytes"},plugin:{kind:"TimeSeriesChart",spec:{yAxis:{showDialog:!0,label:"",format:{unit:"bytes/sec"}},legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        sum(histogram_sum)::float / date_part('epoch', from_unixtime(0) + ($resolution)::interval)::float as total_bytes
      FROM metrics
      WHERE metric_name = 'ingest_request_total_bytes'
      GROUP BY x`}}}}]}},Averagebatchsize:{kind:"Panel",spec:{display:{name:"Average batch size"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        avg((histogram_sum / histogram_count)) / 1024 / 1024 AS average_batch_size_mb
      FROM metrics
      WHERE metric_name = 'ingest_batch_total_bytes'
      GROUP BY x;`}}}}]}},"Maxbatchsize(MB)":{kind:"Panel",spec:{display:{name:"Max batch size (MB)"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        max(histogram_max) / 1024 / 1024 AS max_batch_size_mb
      FROM metrics
      WHERE metric_name = 'ingest_batch_total_bytes'
      GROUP BY x;`,metrics:["max_batch_size_mb"]}}}}]}},FilterCacheHitRate:{kind:"Panel",spec:{display:{name:"Filter Cache Hit Rate"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        avg(histogram_sum / histogram_count) AS filter_cache_hit_rate_percent
      FROM metrics
      WHERE metric_name = 'filter_cache_hit_rate_percent'
      GROUP BY x
      ORDER BY x DESC;`}}}}]}},MaxFileCountsPerDay:{kind:"Panel",spec:{display:{name:"Max File Counts Per Day"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},visual:{stack:"all",display:"line",palette:{mode:"auto"},areaOpacity:.25,connectNulls:!0},thresholds:{}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        max(scalar_value) as max_count
      FROM metrics
      WHERE metric_name = 'daily_file_counts'
      GROUP by x;`,metrics:["max_count"]}}}}]}},"FilterCacheHitRate-1":{kind:"Panel",spec:{display:{name:"Filter Cache Average Lifetime"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS bucket,
        AVG(histogram_sum / NULLIF(histogram_count, 0)) AS avg_item_lifetime_seconds
      FROM metrics
      WHERE metric_name = 'filter_cache_item_lifetime_seconds'
      GROUP BY bucket
      ORDER BY bucket DESC;`}}}}]}},Filtercachespanemits:{kind:"Panel",spec:{display:{name:"Filter cache span emits",description:"Tracks the # of spans emitted by the fusionfire-filter-cache-api"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        count(*)
      FROM records
       where service_name = '${bv}'
      GROUP BY x;`}}}}]}},BatchesflowingintoDLQ:{kind:"Panel",spec:{display:{name:"Batches flowing into DLQ"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        sum(scalar_value) as total_batches_to_dlq
      FROM metrics
      WHERE metric_name = 'sqlite_batches_flushed_to_dlq'
      GROUP BY x;`}}}}]}},"IngestExportsperBatch-1":{kind:"Panel",spec:{display:{name:"Ingest Export Count per Batch/Org",description:"Count of exports / incoming requests batched for each organization in each pull"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        avg(histogram_sum / histogram_count) as avg_batch_size_per_org_per_pull
      FROM metrics
      WHERE metric_name = 'ingest_batch_num_payloads'
      GROUP BY x;`,metrics:["avg_batch_size_per_org_per_pull"]}}}}]}},"IngestExportsperBatch-2":{kind:"Panel",spec:{display:{name:"Ingest Export Count per Batch",description:"Count of incoming requests / payloads batched for each pull (across all orgs in the pull)"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        avg(histogram_sum / histogram_count) as avg_batch_size_per_pull
      FROM metrics
      WHERE metric_name = 'ingest_batch_total_payloads'
      GROUP BY x;`,metrics:["avg_batch_size_per_pull"]}}}}]}},"IngestExportsperBatch-3":{kind:"Panel",spec:{display:{name:"Ingest Export Bytes per Batch",description:"Total bytes of incoming requests / payloads batched for each pull (across all orgs in the pull)"},plugin:{kind:"TimeSeriesChart",spec:{yAxis:{show:!0,label:"",format:{unit:"bytes"}},legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        avg(histogram_sum / histogram_count) as avg_batch_bytes_per_pull
      FROM metrics
      WHERE metric_name = 'ingest_request_total_bytes'
      GROUP BY x;`}}}}]}},"IngestExportsperBatch-4":{kind:"Panel",spec:{display:{name:"Ingest Export Bytes per Batch/Org",description:"Total bytes of incoming requests / payloads batched for each org for each pull (across all orgs in the pull)"},plugin:{kind:"TimeSeriesChart",spec:{yAxis:{show:!0,label:"",format:{unit:"bytes"}},legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        avg(histogram_sum / histogram_count) as avg_batch_bytes_per_pull
      FROM metrics
      WHERE metric_name = 'ingest_batch_bytes'
      GROUP BY x;`,metrics:["avg_batch_bytes_per_pull"]}}}}]}},PeakConcurrentSubmissions:{kind:"Panel",spec:{display:{name:"Peak Concurrent Submissions"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},visual:{stack:"all",areaOpacity:.3,connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        x,
        pod_name,
        sum(scalar_value) as peak
      FROM
          (
          select
              distinct on (pod_name, time_bucket($resolution, created_at))
              pod_name,
              time_bucket($resolution, created_at) AS x,
              scalar_value from
              (
                  select otel_resource_attributes->>'k8s.pod.name' as pod_name,
                  scalar_value,
                  created_at
                  from metrics
                  where metric_name = 'ingest_batch_submissions_peak_concurrent'
                  and service_name = '${Wn}'
              )
          order by
              pod_name,
              time_bucket($resolution, created_at),
              scalar_value desc
          )
      GROUP BY x, pod_name
      ORDER BY pod_name, x DESC;`,groupBy:"pod_name",metrics:["peak"]}}}}]}},Maxwaittimeforaqueryworker:{kind:"Panel",spec:{display:{name:"Max wait time for a query worker"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, recorded_timestamp) AS x,
        max(histogram_max) * 1000 as max_wait_time_ms
      FROM metrics
        where metric_name = 'query_schedule_wait'
      GROUP BY x;`}}}}]}},"PeakConcurrentSubmissions-1":{kind:"Panel",spec:{display:{name:"Active Batch Workers"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},visual:{stack:"all",areaOpacity:.3,connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        x,
        pod_name,
        sum(scalar_value) as active
      FROM
          (
          select
              distinct on (pod_name, time_bucket($resolution, created_at))
              pod_name,
              time_bucket($resolution, created_at) AS x,
              scalar_value from
              (
                  select otel_resource_attributes->>'k8s.pod.name' as pod_name,
                  scalar_value,
                  created_at
                  from metrics
                  where metric_name = 'ingest_active_batch_workers'
                  and service_name = '${Wn}'
              )
          order by
              pod_name,
              time_bucket($resolution, created_at),
              scalar_value desc
          )
      GROUP BY x, pod_name
      ORDER BY pod_name, x DESC;`,groupBy:"pod_name",metrics:["active"]}}}}]}},"IngestQueueReadQueryLatency-1":{kind:"Panel",spec:{display:{name:"Ingest Queue Write Query Latency (ms)"},plugin:{kind:"TimeSeriesChart",spec:{legend:{position:"bottom"},visual:{connectNulls:!0}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`SELECT
        time_bucket($resolution, start_timestamp) AS x,
        avg(histogram_sum / histogram_count) as batch_query_latency_ms
      FROM metrics
