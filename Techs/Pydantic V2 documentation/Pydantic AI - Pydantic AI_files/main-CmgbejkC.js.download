group by model, x`,groupBy:"model",metrics:["tokens"]}}}}]}},"chart_2+1747316590012-1":{kind:"Panel",spec:{display:{name:"Cost by model and type"},plugin:{kind:"TimeSeriesChart",spec:{yAxis:{show:!0,label:"Cost ($)"},legend:{position:"bottom"},visual:{display:"line"}}},queries:[{kind:"TimeSeriesQuery",spec:{plugin:{kind:"LogfireTimeSeriesQuery",spec:{query:`select
