    sum(histogram_sum) tokens,
    attributes->>'gen_ai.token.type' as type,
    time_bucket($resolution, recorded_timestamp) AS x
from metrics
where metric_name = 'gen_ai.client.token.usage' and aggregation_temporality = 'delta'
group by type, x`,groupBy:"type",metrics:["tokens"]}}}}]}},"Bytypetotals-cost":{kind:"Panel",spec:{display:{name:"Total input cost ($)"},plugin:{kind:"Values",spec:{}},queries:[{kind:"NonTimeSeriesQuery",spec:{plugin:{kind:"LogfireNonTimeSeriesQuery",spec:{query:`select
    sum(histogram_sum) as "Input cost"
